#!/bin/sh
# 假 getconf：仅拦截 `getconf PAGESIZE`（检查器基页大小探测），其余参数回退真实 /usr/bin/getconf。
# 设 STUB_REAL_PAGESIZE=1 时全部回退真实 getconf（不打桩）。
set -eu

# STUB_REAL_PAGESIZE=1：用真实 getconf，不拦截 PAGESIZE
if [ "${STUB_REAL_PAGESIZE:-0}" = "1" ]; then
    exec /usr/bin/getconf "$@"
fi

PROFILE_DIR="${STUB_DIR:-/opt/kvpool-stub}/profiles/${STUB_PROFILE:-a2}"
if [ "${1:-}" = "PAGESIZE" ] 2>/dev/null; then
    cat "$PROFILE_DIR/pagesize.txt"
else
    exec /usr/bin/getconf "$@"
fi
